# Développement local uniquement. En production, utiliser les variables du serveur ou config/secrets.php.
# Un .env situé dans la racine web publique est ignoré hors APP_ENV=local.
APP_ENV=production
# production | control : une API de contrôle doit utiliser une autre base, une autre APP_KEY et un autre domaine
APP_ROLE=production
APP_KEY=

# Origine autorisée pour les appels du frontend (pas de joker)
CORS_ORIGIN=
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_PATH=/api

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
# Optionnel : certificat de l'autorité pour une connexion TLS si l'hébergeur l'impose
DB_SSL_CA=

# Contrôle uniquement
CONTROL_DB_NAME=
PREFLIGHT_TOKEN=
RATE_LIMIT_BOOKINGS=5
RATE_LIMIT_QUOTES=5
RATE_LIMIT_LOGIN=5

# Optionnel, uniquement derrière un proxy de confiance : ex. HTTP_X_FORWARDED_FOR
CLIENT_IP_HEADER=
